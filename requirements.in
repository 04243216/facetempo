# FaceTempo 直接依赖（人读清单）
# 云端安装：requirements.txt（精简，兼容 Hugging Face Spaces）
# 本地完整锁定：requirements-dev.txt（pip freeze 生成）# 实测环境：Windows + Python 3.12.10
# 注意：mediapipe 1.x 已移除 mp.solutions，src 中使用 Tasks API（tasks.vision.FaceLandmarker）
# 安装：venv\Scripts\python.exe -m pip install -r requirements.txt

# ---------- W1：关键点提取 + 特征表 + 曲线 ----------
opencv-python>=5.0,<6        # 实测 5.0.0.93（视频读写、叠加绘制）
mediapipe>=1.2,<2            # 实测 1.2.2（附带 opencv-contrib-python）
numpy>=2.5,<3                # 实测 2.5.4（关键点数值计算）
pandas>=3.1,<4               # 实测 3.1.1（逐帧特征 CSV）
matplotlib>=3.11,<4          # 实测 3.11.2（特征曲线图）

# ---------- W5：演示界面 ----------
gradio>=6.0,<7               # 实测 6.32.0（src/app/app.py）

# ---------- W7 - W9：轻量基线（到周次再启用）----------
